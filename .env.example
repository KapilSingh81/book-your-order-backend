PORT=8000
BASE_URL=http://localhost:8000
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=1d
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=book_your_order
# true: order sirf tab jab table ke printed QR ka token sahi ho
REQUIRE_QR_TOKEN=true
# comma separated, e.g. https://myhotel.in,http://localhost:4200  (khali = sab allowed)
CORS_ORIGINS=
# development me true rakho. Production me migrations use karo
DB_SYNC_ALTER=true
# true: customer apne phone se pay kar sake (payment gateway ke baad). false: counter par payment
ALLOW_CUSTOMER_PAY=false
# seed demo hotel ke QR me jaane wala public address (optional)
PUBLIC_SITE_URL=

# Push notifications (staff phone/laptop). Generate your OWN keys: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@yourhotel.com
# Kitne minute "placed" rehne par staff ko dubara push jaye
STALE_ORDER_MIN=3
